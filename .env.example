# --- Server ---
PORT=3000
POLL_SECONDS=30

# --- Claude on AWS Bedrock (the agent's brain) ---
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock model IDs are "anthropic."-prefixed. Some AWS accounts require an
# inference-profile id (e.g. us.anthropic.claude-sonnet-4-6) or a dated
# variant — if you get model-not-found, check Bedrock console > Model access.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# --- Jua AI weather data (M4 — not required while DEMO_MODE=true) ---
JUA_API_KEY=
JUA_BASE_URL=https://api.jua.ai

# --- Composio (real-world actions: Slack, Gmail, Google Calendar) ---
# Requires connecting Slack/Gmail/Google Calendar in the Composio dashboard first.
COMPOSIO_API_KEY=
# Optional overrides used for demos (preferred over asset contact fields)
SLACK_CHANNEL_ID=
DEMO_EMAIL_TO=

# --- Thesys C1 generative UI (optional panel — stretch) ---
THESYS_API_KEY=

# --- ClickHouse decision log (M5 stretch) ---
CLICKHOUSE_URL=
CLICKHOUSE_PASSWORD=

# true = injected storms only, never call Jua (the demo mode)
DEMO_MODE=true

# Dev only: return canned decisions instead of calling Bedrock. Exercises the
# full decide→act→broadcast pipeline with zero AWS creds (clearly labeled
# "(fake brain)" in output). Also a live-demo fallback if Bedrock flakes.
# FAKE_BRAIN=true
