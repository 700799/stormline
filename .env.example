# --- Server ---
PORT=3000
POLL_SECONDS=30

# --- Claude brain provider ---
# Fastest path: OpenRouter (OpenAI-compatible). If OPENROUTER_API_KEY is set it
# is used automatically; force a choice with BRAIN_PROVIDER=openrouter|bedrock.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BRAIN_PROVIDER=

# --- Claude on AWS Bedrock (alternative brain — optional if using OpenRouter) ---
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock model IDs are "anthropic."-prefixed. Some AWS accounts require an
# inference-profile id (e.g. us.anthropic.claude-sonnet-4-6) or a dated
# variant — if you get model-not-found, check Bedrock console > Model access.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# --- Weather ingestion (DEMO_MODE=false) ---
# Jua was dropped for submission; src/data/mock-payload.json is ingested instead
# (no key needed). Edit that file to change the "live" storm.

# --- Composio (real-world actions: Slack, Gmail, Google Calendar) ---
# Requires connecting Slack/Gmail/Google Calendar in the Composio dashboard first.
# Without COMPOSIO_API_KEY, actions run in labeled WOULD-EXECUTE dry-run mode.
COMPOSIO_API_KEY=
# Composio user/entity id your connected accounts live under (default: "default")
COMPOSIO_USER_ID=
# Optional overrides used for demos (preferred over asset contact fields)
SLACK_CHANNEL_ID=
DEMO_EMAIL_TO=
# Real Google Calendar event id standing in for "event-bayfest" — required for a
# real calendar move; without it reschedule_event stays state-only/dry-run.
DEMO_CALENDAR_EVENT_ID=

# --- OpenUI generative status card (3rd sponsor integration) ---
# Without a key the dashboard shows a clearly-labeled local fallback card.
OPENUI_API_KEY=
THESYS_API_KEY=
# OpenAI-chat-completions-compatible endpoint + model. Defaults target the
# Thesys C1 OpenUI offering; override if your sponsor account differs
# (could not be verified offline from the build sandbox).
OPENUI_BASE_URL=https://api.thesys.dev/v1/embed
OPENUI_MODEL=c1/anthropic/claude-sonnet-4/v-20250617

# --- ClickHouse decision log (M5 stretch) ---
CLICKHOUSE_URL=
CLICKHOUSE_PASSWORD=

# true = injected storms only, never call Jua (the demo mode)
DEMO_MODE=true

# Dev only: return canned decisions instead of calling Bedrock. Exercises the
# full decide→act→broadcast pipeline with zero AWS creds (clearly labeled
# "(fake brain)" in output). Also a live-demo fallback if Bedrock flakes.
# FAKE_BRAIN=true
